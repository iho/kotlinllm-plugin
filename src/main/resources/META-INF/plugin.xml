<!-- Plugin Configuration File: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN, cannot be changed between the plugin versions. -->
    <id>com.jetbrains.kotlinllm.kotlinllm-plugin</id>

    <name>KotlinLLM</name>

    <vendor url="https://www.jetbrains.com">JetBrains Research</vendor>

    <description><![CDATA[
        KotlinLLM is an experimental IntelliJ IDEA plugin for Kotlin/JVM projects that turns explicit Smart Macro calls into generated Kotlin source code.<br><br>
        Use <code>asLlm</code> to generate typed conversion logic from observed runtime values, or <code>mockLlm</code> to evolve interface mocks from observed calls. Generated behavior is written back into the target project as ordinary Kotlin and can be inspected, edited, committed, and run without calling an LLM for already learned scenarios.<br><br>
        KotlinLLM requires a user-provided OpenAI API key and sends selected runtime values from Smart Macro invocations to the configured LLM provider while generating code.
    ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->

    <depends>org.jetbrains.kotlin</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>org.jetbrains.plugins.gradle</depends>
    <resource-bundle>messages.MyMessageBundle</resource-bundle>
    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <executor implementation="com.jetbrains.kotlinllm.kotlinllmplugin.execute.KotlinLlmExecutor"/>
        <programRunner implementation="com.jetbrains.kotlinllm.kotlinllmplugin.execute.KotlinLlmRunner"/>
        <runConfigurationExtension implementation="com.jetbrains.kotlinllm.kotlinllmplugin.execute.KotlinLlmRunConfigurationExtension"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <actions>
        <action
                id="KotlinLlm.InitKotlinLlm"
                class="com.jetbrains.kotlinllm.kotlinllmplugin.actions.KotlinLlmSettingsAction"
                text="KotlinLLM Settings"
                description="Configure KotlinLLM project settings and advanced log actions"
                icon="/icons/kotlinllm.svg">
            <add-to-group group-id="MainToolbarRight" anchor="last"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action
                id="KotlinLlm.RunSnapshotOrchestration"
                class="com.jetbrains.kotlinllm.kotlinllmplugin.snapshot.RunSnapshotOrchestrationAction"
                text="Run Snapshot Orchestration"
                description="Run the multi-agent snapshot convention (SpecAuthor, SpecReviewer, Snapshotter, TestGenerator, MutationAuditor) and drive mutflow coverage">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
